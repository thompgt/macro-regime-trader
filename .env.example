# Copy to .env and adjust as needed. No API key required for the default yfinance provider.
# Every value below matches the in-code default in config.py.

MRT_DATA_CACHE_DIR=data_cache
MRT_LOG_LEVEL=INFO

# Risk manager limits
MRT_STARTING_BALANCE=100000
MRT_SLIPPAGE_PCT=0.0004
# Single-session loss that trips a temporary halt, and how long the halt lasts.
MRT_CIRCUIT_BREAKER_DRAWDOWN_PCT=0.04
MRT_CIRCUIT_BREAKER_HALT_STEPS=10
# Permanent shutdown. Keep this well beyond the strategy's expected worst
# drawdown: the lock is irreversible, so a tight threshold turns a survivable
# decline into a dead account for the rest of the run.
MRT_KILL_SWITCH_DRAWDOWN_PCT=0.50
# Financing, so leverage is never free.
MRT_MARGIN_INTEREST_RATE=0.05
MRT_CASH_YIELD_RATE=0.02

# Regime engine
MRT_EMA_FAST=20
MRT_EMA_SLOW=50
MRT_VOLUME_ZSCORE_WINDOW=20
# Long-term trend filter, and the fast re-entry filter that keeps the book from
# sitting out V-shaped recoveries.
MRT_TREND_WINDOW=200
MRT_RECLAIM_WINDOW=20
MRT_REALIZED_VOL_WINDOW=20
MRT_REALIZED_VOL_LOOKBACK=252
MRT_HIGH_VOL_PERCENTILE=0.80
MRT_LOW_VOL_PERCENTILE=0.35

# Strategy sizing
MRT_TARGET_ANNUAL_VOL=0.16
MRT_VOL_SCALAR_SMOOTHING=10
# Gearing on the risk-on book. Set to 1.0 for the unlevered version.
MRT_BASE_LEVERAGE=1.5
MRT_MAX_LEVERAGE=1.6
# Exposure drift tolerated before the broker rebalances.
MRT_REBALANCE_BAND=0.25
# ATR trailing stop is off by default; it was redundant with the regime gate and
# the volatility de-risk scalar, and cost both return and Sharpe.
MRT_USE_ATR_STOP=false
MRT_ATR_STOP_MULTIPLIER=4.0
MRT_ATR_WINDOW=14
MRT_DONCHIAN_WINDOW=20
MRT_REENTRY_COOLDOWN_BARS=5

# Backtest
MRT_TRAIN_WINDOW=180
MRT_TEST_WINDOW=60
MRT_BENCHMARK_DMA_WINDOW=200
# Calendar days of history fetched before the reported start, used only to warm
# up indicators so the strategy is not compared flat against a live benchmark.
MRT_WARMUP_CALENDAR_DAYS=520
